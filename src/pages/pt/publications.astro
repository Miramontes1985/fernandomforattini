---
import { allPublicationSections, type Locale } from "../../data/publications";
import globalStyles from "../../styles/global.css?raw";

const locale: Locale = "pt";
const totalItems = allPublicationSections.reduce((total, section) => total + section.items.length, 0);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Textos selecionados de Fernando Miramontes Forattini em sociologia histórica, governança, desigualdade e sistemas sociotécnicos."
    />
    <title>Textos Selecionados | Fernando Miramontes Forattini</title>
    <link rel="alternate" hreflang="en" href="https://fernandomforattini.com/publications/" />
    <link rel="alternate" hreflang="pt-BR" href="https://fernandomforattini.com/pt/publications/" />
    <style is:global set:html={globalStyles}></style>
  </head>
  <body>
    <header class="site-header" aria-label="Cabeçalho do site">
      <a class="brand" href="/pt/" aria-label="Página inicial de Fernando Miramontes Forattini">
        <span class="brand-mark">Fernando Miramontes Forattini</span>
        <span class="brand-sub">Sociologia Histórica · Governança · Tecnologia</span>
      </a>

      <nav class="site-nav" id="site-nav" data-site-nav aria-label="Navegação principal">
        <a href="/pt/research/">Pesquisa</a>
        <a href="/pt/publications/">Publicações</a>
        <a href="/pt/#teaching">Ensino</a>
        <a href="/pt/#projects">Atuação</a>
        <a href="/cv/fernando-miramontes-forattini-cv-portuguese.pdf" download>CV</a>
        <a href="/pt/#contact">Contato</a>
      </nav>

      <div class="language-switcher" aria-label="Seletor de idioma">
        <a href="/publications/">EN</a>
        <a class="is-active" href="/pt/publications/" aria-current="page">PT</a>
      </div>

      <button class="menu-button" type="button" data-menu-button aria-expanded="false" aria-controls="site-nav">
        <span class="menu-lines" aria-hidden="true"></span>
        <span class="sr-only">Abrir menu</span>
      </button>
    </header>

    <main class="subpage-main">
      <section class="subpage-hero">
        <p class="section-kicker">Publicações</p>
        <h1 class="section-title">Textos selecionados.</h1>
        <p class="section-copy">
          Lista selecionada da produção acadêmica, organizada por linha de pesquisa e seguida por
          livros e livros organizados.
        </p>
        <p class="publication-source-link">
          Para uma lista mais completa de publicações, consulte o
          <a href="https://scholar.google.com/citations?user=uwh-tBIAAAAJ&hl=pt-BR" target="_blank" rel="noreferrer">Google Scholar</a>.
        </p>
        <p class="archive-count">{totalItems} publicações e livros selecionados</p>
        <nav class="publication-jump-list" aria-label="Seções de publicações">
          {
            allPublicationSections.map((section) => (
              <a href={`#${section.id}`}>
                <span>{section.title[locale]}</span>
                <small>{section.items.length}</small>
              </a>
            ))
          }
        </nav>
      </section>

      {
        allPublicationSections.map((section) => (
          <section class="publication-section" id={section.id} aria-labelledby={`${section.id}-title`}>
            <div class="publication-section-heading">
              <p class="section-kicker">{section.kicker[locale]}</p>
              <h2 id={`${section.id}-title`}>{section.title[locale]}</h2>
              <p>{section.intro[locale]}</p>
            </div>

            <div class="publication-stack">
              {section.items.map((item) => (
                <article class:list={["publication-card", { "is-featured": item.featured }]}>
                  <p class="meta">{item.meta[locale]}</p>
                  <p class="publication-citation">{item.citation[locale]}</p>
                </article>
              ))}
            </div>

            {section.note && <p class="publication-note">{section.note[locale]}</p>}
          </section>
        ))
      }
    </main>

    <footer class="site-footer">
      <span>© 2026 Fernando Miramontes Forattini</span>
      <a href="/pt/">Início</a>
    </footer>

    <script>
      import "../../scripts/scroll-story.js";
    </script>
  </body>
</html>

---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Fernando Miramontes Forattini is a Marie Skłodowska-Curie Postdoctoral Fellow studying power, governance, inequality, and technology."
    />
    <title>Fernando Miramontes Forattini | Historical Sociology, Governance, and Sociotechnical Systems</title>
  </head>
  <body>
    <header class="site-header" aria-label="Site header">
      <a class="brand" href="#top" aria-label="Fernando Miramontes Forattini homepage">
        <span class="brand-mark">Fernando Miramontes Forattini</span>
        <span class="brand-sub">Historical Sociology · Governance · Technology</span>
      </a>

      <nav class="site-nav" id="site-nav" data-site-nav aria-label="Main navigation">
        <a href="#agenda">Agenda</a>
        <a href="#research">Research</a>
        <a href="#work">Work</a>
        <a href="#projects">Engagement</a>
        <a href="#teaching">Teaching</a>
        <a href="#contact">Contact</a>
      </nav>

      <button class="menu-button" type="button" data-menu-button aria-expanded="false" aria-controls="site-nav">
        <span class="menu-lines" aria-hidden="true"></span>
        <span class="sr-only">Open menu</span>
      </button>
    </header>

    <main id="top">
      <section class="intro-story" data-story aria-label="Research story">
        <div class="story-pin">
          <div class="story-stage" aria-hidden="true">

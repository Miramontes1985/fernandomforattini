                <path d="M430 742 c92 34 180 30 264 -12" />
                <path d="M308 646 c-28 -62 -20 -116 24 -161 c22 -24 48 -38 78 -44" />
              </g>

              <g data-drawing="2" class="story-drawing">
                <path d="M696 344 l142 -74 l138 46 l-10 176 l-160 64 l-128 -78 z" />
                <path d="M838 270 l-32 286" />

                <path d="M1252 476 c40 68 46 134 18 200" />
                <path d="M1092 578 c74 34 145 34 214 0" />
                <circle cx="1374" cy="302" r="30" />
                <circle cx="1448" cy="388" r="24" />
                <circle cx="1356" cy="482" r="28" />
                <circle cx="1484" cy="540" r="20" />
                <path d="M1396 324 l34 44" />
                <path d="M1434 404 l-58 56" />
                <path d="M1382 494 l82 38" />
              </g>

              <g data-drawing="4" class="story-drawing">
                <path d="M146 650 c54 -82 126 -136 216 -160 c96 -25 182 -10 258 46" />
                <path d="M228 540 c34 52 88 78 162 78 c70 0 128 -22 174 -66" />
                <path d="M260 672 c94 50 196 54 306 10" />

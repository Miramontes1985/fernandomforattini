              <g data-drawing="3" class="story-drawing">
                <path d="M1040 376 c-22 -82 6 -151 72 -183 c86 -40 182 4 205 94 c22 84 -22 163 -104 190 c-76 24 -150 -19 -173 -101 z" />
                <path d="M1114 206 c20 52 66 78 138 78" />

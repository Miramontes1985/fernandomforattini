---
import { allPublicationSections, type Locale } from "../../data/publications";
import globalStyles from "../../styles/global.css?raw";

const locale: Locale = "es";
const totalItems = allPublicationSections.reduce((total, section) => total + section.items.length, 0);
---

<!doctype html>
<html lang="es-419">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Textos seleccionados de Fernando Miramontes Forattini en sociología histórica, gobernanza, desigualdad y sistemas sociotécnicos."
    />
    <title>Textos Seleccionados | Fernando Miramontes Forattini</title>
    <link rel="icon" type="image/svg+xml" sizes="any" href="/research-icon.svg?v=2" />
    <link rel="shortcut icon" href="/research-icon.svg?v=2" />
    <link rel="alternate" hreflang="en" href="https://fernandomforattini.com/publications/" />
    <link rel="alternate" hreflang="pt-BR" href="https://fernandomforattini.com/pt/publications/" />
    <link rel="alternate" hreflang="es-419" href="https://fernandomforattini.com/es/publications/" />
    <style is:global set:html={globalStyles}></style>
  </head>
  <body>
    <header class="site-header" aria-label="Encabezado del sitio">
      <a class="brand" href="/es/" aria-label="Página inicial de Fernando Miramontes Forattini">
        <span class="brand-mark">Fernando Miramontes Forattini</span>
        <span class="brand-sub">Sociología Histórica · Gobernanza · Tecnología</span>
      </a>

      <nav class="site-nav" id="site-nav" data-site-nav aria-label="Navegación principal">
        <a href="/es/research/">Investigación</a>
        <a href="/es/publications/">Publicaciones</a>
        <a href="/es/#teaching">Docencia</a>
        <a href="/es/#projects">Trabajo aplicado</a>
        <a href="/cv/fernando-miramontes-forattini-cv-english.pdf" download>CV</a>
        <a href="/es/#contact">Contacto</a>
      </nav>

      <div class="language-switcher" aria-label="Selector de idioma">
        <a href="/publications/">EN</a>
        <a href="/pt/publications/">PT</a>
        <a class="is-active" href="/es/publications/" aria-current="page">ES</a>
      </div>

      <button class="menu-button" type="button" data-menu-button aria-expanded="false" aria-controls="site-nav">
        <span class="menu-lines" aria-hidden="true"></span>
        <span class="sr-only">Abrir menú</span>
      </button>
    </header>

    <main class="subpage-main">
      <section class="subpage-hero">
        <p class="section-kicker">Publicaciones</p>
        <h1 class="section-title">Textos seleccionados.</h1>
        <p class="section-copy">
          Lista seleccionada de producción académica, organizada por línea de investigación y seguida por
          libros y libros editados.
        </p>
        <p class="publication-source-link">
          Para una lista más completa de publicaciones, consulte
          <a href="https://scholar.google.com/citations?user=uwh-tBIAAAAJ&hl=es" target="_blank" rel="noreferrer">Google Scholar</a>.
        </p>
        <p class="archive-count">{totalItems} publicaciones y libros seleccionados</p>
        <nav class="publication-jump-list" aria-label="Secciones de publicaciones">
          {
            allPublicationSections.map((section) => (
              <a href={`#${section.id}`}>
                <span>{section.title[locale]}</span>
                <small>{section.items.length}</small>
              </a>
            ))
          }
        </nav>
      </section>

      {
        allPublicationSections.map((section) => (
          <section class="publication-section" id={section.id} aria-labelledby={`${section.id}-title`}>
            <div class="publication-section-heading">
              <p class="section-kicker">{section.kicker[locale]}</p>
              <h2 id={`${section.id}-title`}>{section.title[locale]}</h2>
              <p>{section.intro[locale]}</p>
            </div>

            <div class="publication-stack">
              {section.items.map((item) => (
                <article class:list={["publication-card", { "is-featured": item.featured }]}>
                  <p class="meta">{item.meta[locale]}</p>
                  <p class="publication-citation">{item.citation[locale]}</p>
                </article>
              ))}
            </div>

            {section.note && <p class="publication-note">{section.note[locale]}</p>}
          </section>
        ))
      }
    </main>

    <footer class="site-footer">
      <span>© 2026 Fernando Miramontes Forattini</span>
      <a href="/es/">Inicio</a>
    </footer>

    <script>
      import "../../scripts/scroll-story.js";
    </script>
  </body>
</html>

---
import { allPublicationSections, type Locale } from "../data/publications";
import globalStyles from "../styles/global.css?raw";

const locale: Locale = "en";
const totalItems = allPublicationSections.reduce((total, section) => total + section.items.length, 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Selected writing by Fernando Miramontes Forattini across historical sociology, governance, inequality, and sociotechnical systems."
    />
    <title>Selected Writing | Fernando Miramontes Forattini</title>
    <link rel="icon" type="image/svg+xml" sizes="any" href="/research-icon.svg?v=2" />
    <link rel="shortcut icon" href="/research-icon.svg?v=2" />
    <link rel="alternate" hreflang="en" href="https://fernandomforattini.com/publications/" />
    <link rel="alternate" hreflang="pt-BR" href="https://fernandomforattini.com/pt/publications/" />
    <style is:global set:html={globalStyles}></style>
  </head>
  <body>
    <header class="site-header" aria-label="Site header">
      <a class="brand" href="/" aria-label="Fernando Miramontes Forattini homepage">
        <span class="brand-mark">Fernando Miramontes Forattini</span>
        <span class="brand-sub">Historical Sociology · Governance · Technology</span>
      </a>

      <nav class="site-nav" id="site-nav" data-site-nav aria-label="Main navigation">
        <a href="/research/">Research</a>
        <a href="/publications/">Publications</a>
        <a href="/#teaching">Teaching</a>
        <a href="/#projects">Applied Work</a>
        <a href="/cv/fernando-miramontes-forattini-cv-english.pdf" download>CV</a>
        <a href="/#contact">Contact</a>
      </nav>

      <div class="language-switcher" aria-label="Language selector">
        <a class="is-active" href="/publications/" aria-current="page">EN</a>
        <a href="/pt/publications/">PT</a>
      </div>

      <button class="menu-button" type="button" data-menu-button aria-expanded="false" aria-controls="site-nav">
        <span class="menu-lines" aria-hidden="true"></span>
        <span class="sr-only">Open menu</span>
      </button>
    </header>

    <main class="subpage-main">
      <section class="subpage-hero">
        <p class="section-kicker">Publications</p>
        <h1 class="section-title">Selected writing.</h1>
        <p class="section-copy">
          A selected list of academic writing, organized by research line and followed by books and
          edited books.
        </p>
        <p class="publication-source-link">
          For a fuller list of publications, see
          <a href="https://scholar.google.com/citations?user=uwh-tBIAAAAJ&hl=en" target="_blank" rel="noreferrer">Google Scholar</a>.
        </p>
        <p class="archive-count">{totalItems} selected publications and books</p>
        <nav class="publication-jump-list" aria-label="Publication sections">
          {
            allPublicationSections.map((section) => (
              <a href={`#${section.id}`}>
                <span>{section.title[locale]}</span>
                <small>{section.items.length}</small>
              </a>
            ))
          }
        </nav>
      </section>

      {
        allPublicationSections.map((section) => (
          <section class="publication-section" id={section.id} aria-labelledby={`${section.id}-title`}>
            <div class="publication-section-heading">
              <p class="section-kicker">{section.kicker[locale]}</p>
              <h2 id={`${section.id}-title`}>{section.title[locale]}</h2>
              <p>{section.intro[locale]}</p>
            </div>

            <div class="publication-stack">
              {section.items.map((item) => (
                <article class:list={["publication-card", { "is-featured": item.featured }]}>
                  <p class="meta">{item.meta[locale]}</p>
                  <p class="publication-citation">{item.citation[locale]}</p>
                </article>
              ))}
            </div>

            {section.note && <p class="publication-note">{section.note[locale]}</p>}
          </section>
        ))
      }
    </main>

    <footer class="site-footer">
      <span>© 2026 Fernando Miramontes Forattini</span>
      <a href="/">Home</a>
    </footer>

    <script>
      import "../scripts/scroll-story.js";
    </script>
  </body>
</html>
